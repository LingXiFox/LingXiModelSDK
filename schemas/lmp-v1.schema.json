{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.lingxifox.cn/schemas/lmp-v1.schema.json",
  "title": "LingXi Model Protocol v1.0 Request",
  "type": "object",
  "required": ["model", "messages"],
  "additionalProperties": true,
  "properties": {
    "model": { "type": "string", "minLength": 1 },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant", "tool"] },
          "content": { "type": "array", "items": { "type": "object", "required": ["type"] } }
        }
      }
    },
    "maxTokens": { "type": ["integer", "null"], "minimum": 1 },
    "temperature": { "type": ["number", "null"] },
    "tools": { "type": "array", "items": { "type": "object", "required": ["name", "parameters"] } },
    "thinking": {
      "type": ["object", "null"],
      "properties": {
        "effort": { "type": ["string", "null"], "enum": ["minimal", "low", "medium", "high", null] },
        "budgetTokens": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "responseFormat": {
      "type": ["object", "null"],
      "properties": {
        "type": { "type": "string", "enum": ["text", "json_object", "json_schema"] }
      }
    },
    "timeoutMs": { "type": ["integer", "null"], "minimum": 1 },
    "providerExtensions": { "type": "object", "additionalProperties": true }
  }
}
