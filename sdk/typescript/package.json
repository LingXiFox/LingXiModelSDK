{
  "name": "@lingxifox/model-sdk",
  "version": "2.0.0-alpha.1",
  "description": "Zero-dependency TypeScript/JavaScript SDK for the LingXi public model catalog",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./src/registry/index.ts",
      "default": "./dist/registry/index.js"
    },
    "./native": {
      "types": "./src/native/index.ts",
      "default": "./dist/native/index.js"
    },
    "./unified": {
      "types": "./src/unified/index.ts",
      "default": "./dist/unified/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "build": "node build.mjs",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "src"
  ]
}
